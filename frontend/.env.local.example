# 이 파일을 복사해 .env.local 을 만드세요 (.env.local 은 Git에 올라가지 않습니다)
#   PowerShell: Copy-Item .env.local.example .env.local
#   Git Bash / macOS / Linux: cp .env.local.example .env.local
# 값을 바꾼 뒤에는 npm run dev 를 Ctrl+C 로 끄고 다시 실행해야 반영됩니다.
# NEXT_PUBLIC_ 로 시작하는 값은 브라우저에 그대로 노출됩니다. API 키 같은 비밀 값은 절대 넣지 마세요.

# true(기본): 목 데이터로 동작 (백엔드 불필요) / false: 아래 주소의 FastAPI 서버 사용
NEXT_PUBLIC_USE_MOCK=true

# 실제 백엔드 API 기본 주소 (끝에 / 없이)
# Windows에서 localhost가 IPv6(::1)로 먼저 해석되어 IPv4 전용 uvicorn에 ECONNREFUSED가 나므로 127.0.0.1을 씁니다
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api

# 관리자 콘솔 자동 새로고침 주기(밀리초). 0이면 끔. 기본 10000(10초)
NEXT_PUBLIC_ADMIN_POLL_MS=10000

# 회의록 상세(/) 화면이 여는 기본 회의 ID (목 데이터의 ID와 같음)
# ※ v1.9.4부터 "/"는 회의 목록이라 이 값은 더는 쓰이지 않습니다 (호환을 위해 줄만 남겨 둠)
NEXT_PUBLIC_DEFAULT_MEETING_ID=mtg-2026-0925

# 실서버 요청 기한(밀리초). 이 시간 안에 응답이 없으면 "Loading…"에서 멈추지 않고 오류를 보여 줍니다. 기본 10000
NEXT_PUBLIC_API_TIMEOUT_MS=10000

# 음성 업로드 요청 기한(밀리초). 큰 파일 전송용이라 위의 일반 기한과 따로 둡니다. 기본 600000(10분)
NEXT_PUBLIC_UPLOAD_TIMEOUT_MS=600000

# 업로드 후 작업 진행 상태 조회(폴링) 주기(밀리초). 기본 3000(3초)
NEXT_PUBLIC_UPLOAD_POLL_MS=3000

# v2 백엔드(backend/) API 기본 주소 (끝에 / 없이). /v2 화면(로그인·할 일 등)이 이 주소만 씁니다.
# backend/ 는 스텁(8000)과 겹치지 않게 8001 포트로 실행합니다. 백엔드 CORS_ORIGINS 에 프론트 주소가 있어야 합니다.
NEXT_PUBLIC_API_V2_BASE_URL=http://127.0.0.1:8001/api

# v2 음성 업로드 요청 기한(밀리초). 큰 파일 전송용이라 일반 요청 기한(30초)과 따로 둡니다. 기본 600000(10분)
NEXT_PUBLIC_V2_UPLOAD_TIMEOUT_MS=600000
