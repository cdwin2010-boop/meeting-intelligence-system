{
  "version": 1,
  "notice": "엔진 시험(벤치마크) 변수의 기본값·허용 범위·프리셋 정의는 이 파일 한 곳에서만 관리한다(코드에 박지 않는다). settingsKey 가 있으면 기본값은 해당 설정(config.py)의 현재 값이다.",
  "params": [
    {"key": "contextTokens", "label": "맥락 길이", "unit": "토큰", "type": "int", "default": 8192, "settingsKey": "remote_llm_context_tokens",
     "min": 2048, "max": 32768, "guide": "모델이 한 번에 읽는 길이입니다. 클수록 VRAM 을 많이 씁니다. Ollama 방식에서만 서버로 보냅니다.", "requires": "ollama"},
    {"key": "chunkChars", "label": "구간 크기", "unit": "글자", "type": "int", "default": 0, "autoValue": 0,
     "min": 200, "max": 12000, "guide": "전사본을 나누는 한 구간의 글자 수입니다. 0 이면 자동(맥락 길이에서 계산)입니다."},
    {"key": "outputReserveTokens", "label": "출력 예약 토큰", "unit": "토큰", "type": "int", "default": 2048,
     "min": 256, "max": 4096, "guide": "답변을 위해 비워 두는 토큰입니다. 맥락 길이의 1/4 을 넘으면 서버가 맥락의 1/4 로 줄입니다."},
    {"key": "repeat", "label": "반복 횟수", "unit": "회", "type": "int", "default": 5, "settingsKey": "bench_repeat",
     "min": 1, "max": 20, "guide": "전체 측정에서 항목(A~F)별로 반복하는 횟수입니다."},
    {"key": "driftRuns", "label": "드리프트 횟수", "unit": "회", "type": "int", "default": 5, "settingsKey": "bench_drift_runs",
     "min": 1, "max": 20, "guide": "같은 입력을 연속 실행해 시간이 변하는지 보는 횟수입니다."},
    {"key": "retryMax", "label": "재시도 횟수", "unit": "회", "type": "int", "default": 2, "settingsKey": "bench_retry_max",
     "min": 0, "max": 5, "guide": "연결 오류(끊김·시간 초과·5xx) 때 항목을 다시 시도하는 횟수입니다."},
    {"key": "retryDelaySeconds", "label": "재시도 간격", "unit": "초", "type": "float", "default": 3, "settingsKey": "bench_retry_delay_seconds",
     "min": 0, "max": 60, "guide": "재시도 사이에 기다리는 시간입니다."},
    {"key": "itemTimeoutSeconds", "label": "항목 제한 시간", "unit": "초", "type": "float", "default": 180, "settingsKey": "bench_item_timeout_seconds",
     "min": 1, "max": 3600, "guide": "요청 1회가 응답을 기다리는 최대 시간입니다."},
    {"key": "longMaxChars", "label": "긴 전사 최대 글자", "unit": "글자", "type": "int", "default": 80000, "settingsKey": "bench_long_max_chars",
     "min": 2000, "max": 500000, "guide": "분할 경로를 일으키기 위해 만드는 긴 가상 전사본의 글자 수 상한입니다."}
  ],
  "presets": [
    {"id": "A", "name": "빠른 확인", "values": {"contextTokens": 8192, "chunkChars": 0, "repeat": 1, "driftRuns": 1}},
    {"id": "B", "name": "표준", "values": {"contextTokens": 8192, "chunkChars": 0, "repeat": 5, "driftRuns": 5}},
    {"id": "C", "name": "중간 맥락", "values": {"contextTokens": 16384, "chunkChars": 0, "repeat": 5, "driftRuns": 5}},
    {"id": "D", "name": "큰 맥락", "values": {"contextTokens": 24576, "chunkChars": 0, "repeat": 3, "driftRuns": 3}}
  ],
  "sweep": {"order": ["B", "C", "D"]},
  "serverDefaultContexts": [2048, 4096],
  "truncationSuspectRatio": 0.98,
  "estimateMarginRatio": 1.5
}
