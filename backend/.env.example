# 이 파일을 복사해 backend/.env 로 저장하고 필요한 값만 바꾼다 (.env 는 커밋 금지)
# DB 연결 주소. SQLite로 시작하고 운영 전 PostgreSQL로 옮긴다 (예: postgresql+psycopg://user:pass@host/db)
DATABASE_URL=sqlite:///./data/app.db
# SQLite 전용(다른 DB 주소면 무시). 잠금 대기(밀리초): 다른 연결이 쓰는 중일 때 이만큼 기다린 뒤 "database is locked" 로 실패
SQLITE_BUSY_TIMEOUT_MS=10000
# SQLite 저널 모드: WAL(기본) / DELETE(되돌릴 때). 기존 DB 파일은 서버를 다음에 시작할 때 WAL 로 바뀐다.
# WAL 에서는 -wal·-shm 파일이 함께 생기므로 백업은 서버를 끄고 복사하거나 SQLite 백업 방식으로 한다
SQLITE_JOURNAL_MODE=WAL
# 유사 업무 검색: 최소 점수(0~100) / 최대 결과 건수 / 후보 훑기 상한(최신 회의 순)
SIMILAR_MIN_SCORE=50
SIMILAR_MAX_RESULTS=10
SIMILAR_SCAN_MAX=300
# 실행 환경: dev / test / prod
APP_ENV=dev
# 로그인 토큰 서명 키. APP_ENV 가 dev 가 아니면 반드시 긴 무작위 값으로 설정(비우면 dev 기본값 → 시작 거부)
# 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# 로그인 토큰 유효 시간(분)
ACCESS_TOKEN_MINUTES=480
# ---- Gemini (STT·업무 추출) ----
# 사용할 키: free 또는 paid. 선택한 모드의 키가 비어 있으면 오류(다른 모드의 키로 자동 전환하지 않음)
GEMINI_KEY_MODE=free
# 무료 키 / 유료 키 (값은 .env 에만, 커밋 금지)
GEMINI_API_KEY=
GEMINI_PAID_API_KEY=
# STT·추출 공통 모델 이름
GEMINI_MODEL=gemini-3.8-flash
# Gemini 요청 1건·업로드 파일 처리 대기의 기한(초)
GEMINI_TIMEOUT_SEC=900
# 일시 오류(HTTP 500·502·503·504·접속 오류) 자동 재시도 횟수(generate_content 호출 하나하나). 0 이면 끔.
# 타임아웃·429(한도 초과)·기타 4xx·키 오류는 재시도하지 않는다
GEMINI_RETRY_MAX=2
# 첫 재시도 전 대기(초). 재시도마다 2배, 최대 60초까지만
GEMINI_RETRY_BACKOFF_SEC=5
# ---- 음성 업로드·처리 ----
# 전사 엔진: fake(가짜 대본) / gemini. 업무 추출기도 같은 값을 따른다
STT_PROVIDER=fake
# 업로드 음성 보관 폴더(하위에 고객사id/무작위이름.확장자로 저장, data/ 는 커밋 제외)
UPLOAD_DIR=data/uploads
# 업로드 최대 크기(MB)
# 왼쪽 메뉴 "처리 현황"이 따라가는 기간(시간). 내가 올린 회의록 중 이 시간 안에 처리가 시작된 것(기본 24)
PROCESSING_TRACK_HOURS=24
# 업무 근거 시각을 서버가 전사문과 대조할 때의 최소 일치율(0~100, 기본 80). 완전 일치는 항상 성공이고, 이 값에 못 미치면 대조 실패(Gemini 가 준 시각이 전사문 안이면 그 값, 아니면 비움)
EVIDENCE_MATCH_MIN=80
MAX_UPLOAD_MB=200
# 허용 확장자(쉼표 구분)
ALLOWED_AUDIO_EXT=m4a,mp3,wav,mp4,webm,ogg
# 회의 일시를 현지 시각으로 바꿀 시간대(IANA 이름)
APP_TIMEZONE=Asia/Seoul
# ---- 메일 (기본 꺼짐: false 면 실제로 보내지 않고 대기 메일을 skipped 처리) ----
MAIL_ENABLED=false
# SMTP 서버(STARTTLS). 값은 .env 에만, 커밋·출력 금지
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 메일 본문의 로그인 링크 주소
APP_BASE_URL=
# ---- CORS ----
# 브라우저에서 이 API 를 부를 수 있는 프론트 주소(쉼표 구분). '*' 는 시작 거부
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 실행(backend 폴더에서, stub(8000)과 겹치지 않게 8001): uvicorn app.main:app --port 8001
# ---- 업무 처리 현황 전일 집계 ----
# 하루 한 번 자동 집계(true/false). 서버가 켜져 있을 때만 돌며, 꺼져 있었으면 켜질 때 따라잡는다
WORKLOAD_SNAPSHOT_ENABLED=true
# 집계 시각(APP_TIMEZONE 기준 HH:MM). 이 시각 이후 전일 기준일 집계가 없으면 실행한다
WORKLOAD_SNAPSHOT_TIME=00:10
# 미완료(진행 중+지연) 건수가 이 값 이상이면 화면에 "미완료 과다" 주의 배지(기본 5)
WORKLOAD_OVERLOAD_THRESHOLD=5
# 집중 관리 목록(지연·D-3 임박)을 계정·부서 행마다 저장할 최대 건수(기본 50)
WORKLOAD_URGENT_MAX=50
# ---- 자료 파일(txt) 등록 ----
# txt 파일 크기 상한(바이트, 기본 2097152 = 2MB)과 글자 수 상한(기본 300000). 넘으면 422
TRANSCRIPT_UPLOAD_MAX_BYTES=2097152
TRANSCRIPT_MAX_CHARS=300000
# ---- 작업 큐·워커 (작업 75-1) ----
# 처리 방식: inline(서버가 직접 처리, 기본) / queue(task_queue 에 쌓고 단독 워커 `python worker.py` 가 처리. 워커가 없으면 작업이 대기로 남는다)
PROCESSING_MODE=inline
# 워커가 대기 작업을 확인하는 간격(초)
WORKER_POLL_SECONDS=1.5
# 처리 중 작업을 멈춘 것으로 보는 시간(초). 지나면 대기로 되돌리거나(시도 한도 미만) 실패 처리
WORKER_STALE_SECONDS=1800
# 멈춘 작업의 최대 처리 시도 수(이상이면 실패)
WORKER_MAX_ATTEMPTS=3
# 종료 신호 뒤 현재 작업을 기다리는 시간(초). 넘으면 처리 중 작업을 대기로 되돌리고 종료
WORKER_SHUTDOWN_GRACE=30
# ---- 오디오 전처리 (작업 75-1 파트 B, FFmpeg 단일 체인, 기본 꺼짐) ----
# true 면 STT 입력 직전에 highpass 80Hz·lowpass 8kHz·afftdn·dynaudnorm 을 거친 16kHz 모노 wav 로 바꿔 STT 에 넘긴다
AUDIO_PREPROCESS_ENABLED=false
# true 면 전처리 실패를 처리 실패로 본다. false(기본)면 경고만 남기고 원본 파일로 진행
AUDIO_PREPROCESS_STRICT=false
# ffmpeg 실행 파일. 기본 ffmpeg(PATH 검색). backend/bin/ffmpeg(.exe) 가 있고 이 값이 기본이면 번들 파일을 우선 사용
FFMPEG_PATH=ffmpeg
# ffmpeg 1회 실행 제한(초)
FFMPEG_TIMEOUT_SECONDS=900
# ---- 안건 분할 추론(작업 75-2, 아직 현행 파이프라인에 연결되지 않음) ----
# 청크(안건 구간) 최대 글자 수 / 앞 청크 끝과 겹치는 글자 수(최대 글자 수보다 작아야 함)
EXTRACT_CHUNK_MAX_CHARS=6000
EXTRACT_CHUNK_OVERLAP_CHARS=500
# JSON 파싱 실패 때 교정 프롬프트에 담는 원본 응답 앞부분 최대 글자 수
EXTRACT_RESPONSE_MAX_CHARS_FOR_REPAIR=4000
# LLM 호출 1회 제한 시간(초)
EXTRACT_LLM_TIMEOUT_SECONDS=300
# 파싱 실패 때 교정 재시도 횟수. 코드로 최대 1회만 사용한다(무한 재시도 금지)
EXTRACT_PARSE_RETRY_MAX=1
# 회의록 5개 항목 칸당 최대 글자 수(안건별 내용을 합친 뒤 넘으면 자른다)
EXTRACT_MINUTES_FIELD_MAX_CHARS=4000
# 안건 표지로 인식할 문구를 더한다(쉼표 구분, 발언 맨 앞에서만). 기본 패턴: 첫 번째 안건·다음 안건·안건 N·1.·첫째 등
EXTRACT_AGENDA_MARKERS=
# ---- 하드웨어 감지·권장 모델 프로파일 (작업 77-1, scripts/detect_hardware.py 출력용. 처리 흐름에는 아직 반영되지 않음) ----
# auto = GPU 를 감지해 선택, 또는 프로파일 id(cpu_only·gpu_8gb·gpu_12gb·gpu_16gb_plus)로 고정(고정하면 감지하지 않음)
LLM_PROFILE=auto
# 프로파일 파일(backend 폴더 기준 상대 경로 가능)
HARDWARE_PROFILES_PATH=config/model_profiles.json
# 여유 VRAM 이 총 VRAM 의 이 비율 미만이면 한 단계 낮은 프로파일을 권장(0 초과 1 이하, 기본 0.7)
HARDWARE_MIN_FREE_RATIO=0.7
# ---- 라이선스(사용 허가, 작업 80-1) ----
# 발급받은 .lic 파일(상대 경로는 backend 폴더 기준)
LICENSE_PATH=data/license.lic
# 검증용 공개키 PEM(공개키만 둔다. 개인키는 이 서버에 두지 않는다). 없으면 상태가 public_key_missing 으로 표시됨
LICENSE_PUBLIC_KEY_PATH=config/license_public.pem
# 만료까지 남은 일수가 이 값 이하이면 expiring_soon 으로 표시(0 이상)
LICENSE_WARN_DAYS=30
# true 면 장비 핑거프린트가 들어 있는 라이선스를 이 장비와 대조한다(기본 false)
LICENSE_REQUIRE_HARDWARE_MATCH=false
# ---- 추출(LLM) 엔진과 로컬 LLM (작업 81-1) ----
# auto = STT_PROVIDER 를 따른다(기본, 현행 동작) / gemini / local(아래 로컬 서버) / fake
LLM_PROVIDER=auto
# 로컬 LLM 서버(OpenAI 호환). 주소는 /v1 까지 포함: 요청은 POST {주소}/chat/completions
# 예) http://127.0.0.1:8080/v1  (자리표시자. 실제 값은 이 파일에만 쓰고 출력·커밋하지 않는다)
LOCAL_LLM_BASE_URL=
# 서버에 올린 모델 이름(서버가 알려 주는 이름 그대로)
LOCAL_LLM_MODEL=
# 보통 불필요(기본 not-needed 면 인증 헤더를 보내지 않는다)
LOCAL_LLM_API_KEY=not-needed
# true 면 응답을 JSON 으로 강제하는 옵션(response_format)을 보낸다. 서버가 거부하면 자동으로 빼고 1회 다시 요청한다
LOCAL_LLM_JSON_MODE=true
# 보안 원칙: 기본 false 는 루프백·사설망 주소만 허용. 외부 주소(개발용 터널 포함)를 쓰려면 true(전사 내용이 그 주소로 전송됨, 시스템 관리자만 변경)
LOCAL_LLM_ALLOW_EXTERNAL_HOST=false
# 응답 최대 토큰 수(1 이상)
LOCAL_LLM_MAX_OUTPUT_TOKENS=4096
# 호출 제한 시간은 EXTRACT_LLM_TIMEOUT_SECONDS 를 함께 쓴다

