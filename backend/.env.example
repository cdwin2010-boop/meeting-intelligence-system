# 이 파일을 복사해 backend/.env 로 저장하고 필요한 값만 바꾼다 (.env 는 커밋 금지)
# DB 연결 주소. SQLite로 시작하고 운영 전 PostgreSQL로 옮긴다 (예: postgresql+psycopg://user:pass@host/db)
DATABASE_URL=sqlite:///./data/app.db
# SQLite 전용(다른 DB 주소면 무시). 잠금 대기(밀리초): 다른 연결이 쓰는 중일 때 이만큼 기다린 뒤 "database is locked" 로 실패
SQLITE_BUSY_TIMEOUT_MS=10000
# SQLite 저널 모드: WAL(기본) / DELETE(되돌릴 때). 기존 DB 파일은 서버를 다음에 시작할 때 WAL 로 바뀐다.
# WAL 에서는 -wal·-shm 파일이 함께 생기므로 백업은 서버를 끄고 복사하거나 SQLite 백업 방식으로 한다
SQLITE_JOURNAL_MODE=WAL
# 유사 업무 검색: 최소 점수(0~100) / 최대 결과 건수 / 후보 훑기 상한(최신 회의 순)
SIMILAR_MIN_SCORE=50
SIMILAR_MAX_RESULTS=10
SIMILAR_SCAN_MAX=300
# 실행 환경: dev / test / prod
APP_ENV=dev
# 로그인 토큰 서명 키. APP_ENV 가 dev 가 아니면 반드시 긴 무작위 값으로 설정(비우면 dev 기본값 → 시작 거부)
# 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# 로그인 토큰 유효 시간(분)
ACCESS_TOKEN_MINUTES=480
# ---- Gemini (STT·업무 추출) ----
# 사용할 키: free 또는 paid. 선택한 모드의 키가 비어 있으면 오류(다른 모드의 키로 자동 전환하지 않음)
GEMINI_KEY_MODE=free
# 무료 키 / 유료 키 (값은 .env 에만, 커밋 금지)
GEMINI_API_KEY=
GEMINI_PAID_API_KEY=
# STT·추출 공통 모델 이름
GEMINI_MODEL=gemini-3.8-flash
# Gemini 요청 1건·업로드 파일 처리 대기의 기한(초)
GEMINI_TIMEOUT_SEC=900
# 일시 오류(HTTP 500·502·503·504·접속 오류) 자동 재시도 횟수(generate_content 호출 하나하나). 0 이면 끔.
# 타임아웃·429(한도 초과)·기타 4xx·키 오류는 재시도하지 않는다
GEMINI_RETRY_MAX=2
# 첫 재시도 전 대기(초). 재시도마다 2배, 최대 60초까지만
GEMINI_RETRY_BACKOFF_SEC=5
# ---- 음성 업로드·처리 ----
# 전사 엔진: fake(가짜 대본) / gemini. 업무 추출기도 같은 값을 따른다
STT_PROVIDER=fake
# 업로드 음성 보관 폴더(하위에 고객사id/무작위이름.확장자로 저장, data/ 는 커밋 제외)
UPLOAD_DIR=data/uploads
# 업로드 최대 크기(MB)
# 왼쪽 메뉴 "처리 현황"이 따라가는 기간(시간). 내가 올린 회의록 중 이 시간 안에 처리가 시작된 것(기본 24)
PROCESSING_TRACK_HOURS=24
# 업무 근거 시각을 서버가 전사문과 대조할 때의 최소 일치율(0~100, 기본 80). 완전 일치는 항상 성공이고, 이 값에 못 미치면 대조 실패(Gemini 가 준 시각이 전사문 안이면 그 값, 아니면 비움)
EVIDENCE_MATCH_MIN=80
MAX_UPLOAD_MB=200
# 허용 확장자(쉼표 구분)
ALLOWED_AUDIO_EXT=m4a,mp3,wav,mp4,webm,ogg
# 회의 일시를 현지 시각으로 바꿀 시간대(IANA 이름)
APP_TIMEZONE=Asia/Seoul
# ---- 메일 (기본 꺼짐: false 면 실제로 보내지 않고 대기 메일을 skipped 처리) ----
MAIL_ENABLED=false
# SMTP 서버(STARTTLS). 값은 .env 에만, 커밋·출력 금지
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 메일 본문의 로그인 링크 주소
APP_BASE_URL=
# ---- CORS ----
# 브라우저에서 이 API 를 부를 수 있는 프론트 주소(쉼표 구분). '*' 는 시작 거부
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 실행(backend 폴더에서, stub(8000)과 겹치지 않게 8001): uvicorn app.main:app --port 8001
# ---- 업무 처리 현황 전일 집계 ----
# 하루 한 번 자동 집계(true/false). 서버가 켜져 있을 때만 돌며, 꺼져 있었으면 켜질 때 따라잡는다
WORKLOAD_SNAPSHOT_ENABLED=true
# 집계 시각(APP_TIMEZONE 기준 HH:MM). 이 시각 이후 전일 기준일 집계가 없으면 실행한다
WORKLOAD_SNAPSHOT_TIME=00:10
# 미완료(진행 중+지연) 건수가 이 값 이상이면 화면에 "미완료 과다" 주의 배지(기본 5)
WORKLOAD_OVERLOAD_THRESHOLD=5
# 집중 관리 목록(지연·D-3 임박)을 계정·부서 행마다 저장할 최대 건수(기본 50)
WORKLOAD_URGENT_MAX=50
